{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/modernization-task-return-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_type",
    "model_record",
    "input_record",
    "claims",
    "commands",
    "files_read",
    "files_changed",
    "checks",
    "blocked_actions",
    "unknowns",
    "human_decisions_required"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
    },
    "task_type": {
      "enum": [
        "discovery",
        "test-design",
        "implementation",
        "adversarial-review"
      ]
    },
    "model_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_model",
        "claude_code_version",
        "identity_source"
      ],
      "properties": {
        "reported_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claude_code_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "identity_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "input_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_revision",
        "contract_revision",
        "manifest_digest"
      ],
      "properties": {
        "repository_revision": {
          "type": "string",
          "minLength": 7,
          "pattern": "\\S"
        },
        "contract_revision": {
          "type": "string",
          "minLength": 7,
          "pattern": "\\S"
        },
        "manifest_digest": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "kind",
          "source",
          "confidence",
          "verification"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "observation",
              "documentation",
              "inference",
              "proposal"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high",
              "not-applicable"
            ]
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_status",
          "output_evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "exit_status": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "\\S"
          },
          "output_evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "files_read": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "blocked_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "human_decisions_required": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}
